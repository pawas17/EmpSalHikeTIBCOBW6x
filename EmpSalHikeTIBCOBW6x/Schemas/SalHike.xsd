<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/SalHike" xmlns:tns="http://www.example.org/SalHike" elementFormDefault="qualified">

    <element name="EmpID" type="int"></element>

    <element name="EmpName" type="string"></element>

    <complexType name="SalHikeType">
    	<sequence>
    		<element ref="tns:EmpID"></element>
    		<element ref="tns:EmpName"></element>
    	</sequence>
    </complexType>
    
    <element name="SalHike" type="tns:SalHikeType"></element>
</schema>